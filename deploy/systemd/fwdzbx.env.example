# Copy to /etc/fwdzbx/fwdzbx.env, owner root, mode 0600. systemd reads it as root; the service itself runs unprivileged.
# Values here are placeholders. Do not commit a real copy.

# --- Forward (an API token's access key and secret) ---
FORWARD_URL=https://your-forward-host
FORWARD_USERNAME=your-token-access-key
FORWARD_PASSWORD=your-token-secret
# The network every command acts on.
FORWARD_NETWORK_ID=123456

# --- Zabbix ---
ZABBIX_URL=https://zabbix.example.com
# Either an API token (preferred) ...
ZABBIX_TOKEN=your-zabbix-api-token
# ... or a user and password.
# ZABBIX_USER=
# ZABBIX_PASSWORD=
# Trapper endpoint, if it is not the host of ZABBIX_URL on port 10051.
# ZABBIX_SERVER=zabbix.example.com
# ZABBIX_TRAPPER_PORT=10051

# --- Webhook receiver (fwdzbx-receiver.service) ---
# The same user and password go into the Forward webhook's basic-auth credential.
FWDZBX_WEBHOOK_USER=forward
FWDZBX_WEBHOOK_PASSWORD=generate-a-long-random-value
# Only these Forward networks are acted on; events for any other network are ignored.
FWDZBX_NETWORK_IDS=123456
